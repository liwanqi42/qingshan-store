<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.qingshan.mapper.SysMenuMapper">

    <select id="listAll" resultType="com.qingshan.entity.SysMenu">
        select * from sys_menu
        order by sort asc, id asc
    </select>

    <update id="update" parameterType="com.qingshan.entity.SysMenu">
        update sys_menu
        <set>
            <if test="path != null">path = #{path},</if>
            <if test="title != null">title = #{title},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="hidden != null">hidden = #{hidden},</if>
            <if test="more != null">more = #{more},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateUser != null">update_user = #{updateUser},</if>
        </set>
        where id = #{id}
    </update>

</mapper>
