<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.qingshan.mapper.SysDictTypeMapper">

    <select id="listAll" resultType="com.qingshan.entity.SysDictType">
        select * from sys_dict_type
        order by sort asc, id asc
    </select>

    <select id="listEnabled" resultType="com.qingshan.entity.SysDictType">
        select * from sys_dict_type
        where status = 1
        order by sort asc, id asc
    </select>

    <update id="update" parameterType="com.qingshan.entity.SysDictType">
        update sys_dict_type
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateUser != null">update_user = #{updateUser},</if>
        </set>
        where id = #{id}
    </update>

</mapper>
