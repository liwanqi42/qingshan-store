page {
  background-color: #f5f5f5;
}
.settlement {
  padding-bottom: 140rpx;
}
.address{
  width: 100%;
  background-color: #F9F4F4;
  height: 180rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
}
.address .border {
  height: 10rpx;
  width: 100%;
}
.select-address{
  width: 360rpx;
  height: 90rpx;
  border: 1px solid #EB4D50;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 40rpx;
}
.select-address image {
  width: 40rpx;
  height: 40rpx;
}
.select-address .text {
  font-size: 28rpx;
  color: #EB4D50;
  margin-left: 20rpx;
}
.address-info {
  width: 100%;
  display: flex;
  color: #666666;
  margin-top: 40rpx;
  font-size: 24rpx;
  position: relative;
}
.address-info .info {
  flex-grow: 1;
  margin-left: 30rpx;
  padding-right: 80rpx;
  overflow: hidden;
}
.info .contacts {
  font-size: 28rpx;
  color: black;
}
.contacts .mobile {
  font-size: 22rpx;
  color: #999999;
  margin-left: 20rpx;
}
.address-info .position{
  width: 40rpx;
  height: 40rpx;
  margin-left: 30rpx;
  margin-top: 10rpx;
}
.address-info .next-level{
  width: 30rpx;
  height: 30rpx;
  position: absolute;
  right: 30rpx;
  top: 30rpx;
}

/* 通用卡片 */
.card {
  margin-top: 20rpx;
  background-color: #ffffff;
}
.card-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333333;
  padding: 24rpx 30rpx;
  border-bottom: 1px solid #f5f5f5;
}
.card-title .r {
  color: #999999;
  font-size: 24rpx;
}

/* 商品清单 */
.goods-list {
  margin-top: 20rpx;
  background-color: #ffffff;
}
.goods-list .goods {
  border-bottom: 1px solid #F7F7F7;
  display: flex;
  padding: 20rpx
}
.goods-list .goods:last-child {
  border-bottom: none;
}
.goods image {
  width: 120rpx;
  height: 120rpx;
}
.goods .info {
  font-size: 24rpx;
  width: 380rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  margin-left: 20rpx;
}
.info .title {
  height: 80rpx;
  overflow: hidden;
  line-height: 40rpx;
}
.info .specs {
  background-color: #F3F3F3;
  padding: 5rpx 10rpx;
  font-size: 22rpx;
  color: #999999;
  margin-top: 5rpx;
}
.goods .amount {
  flex-grow: 1;
  font-size: 24rpx;
  text-align: right;
}
.amount .price {
  font-weight: bold;
}
.amount .num {
  color: #999999;
}
.goods-qty {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

/* 随手买 */
.addon-scroll {
  white-space: nowrap;
  padding: 24rpx 30rpx;
  box-sizing: border-box;
  width: 100%;
}
.addon-item {
  display: inline-block;
  width: 180rpx;
  margin-right: 20rpx;
  vertical-align: top;
  white-space: normal;
}
.addon-item image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  background-color: #f7f7f7;
}
.addon-title {
  margin-top: 10rpx;
  height: 64rpx;
  overflow: hidden;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #333333;
}
.addon-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.addon-price {
  color: #EB405D;
  font-size: 24rpx;
}
.addon-btn {
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border: 1px solid #EB405D;
  border-radius: 50%;
  box-sizing: border-box;
  color: #EB405D;
  font-size: 28rpx;
}
.addon-btn.checked {
  background-color: #EB405D;
  color: #ffffff;
  line-height: 40rpx;
}

/* 随手买规格选择弹窗 */
.show-popup {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
}
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}
.popup-contents {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.popup-head {
  position: relative;
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx 20rpx;
}
.pop-img-box {
  width: 150rpx;
  height: 150rpx;
  margin-right: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background-color: #f7f7f7;
}
.pop-img-box .goods-thumbnail {
  width: 150rpx;
  height: 150rpx;
}
.pop-goods-des {
  flex: 1;
  min-width: 0;
}
.pop-goods-price {
  color: #ff4400;
  font-size: 38rpx;
  font-weight: bold;
  line-height: 1.1;
}
.pop-price-unit {
  font-size: 24rpx;
  margin-right: 2rpx;
}
.pop-goods-stock {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}
.pop-goods-stockName {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.popup-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 40rpx;
  color: #999;
}
.pop-goods-specs {
  margin: 0 28rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f2f2f2;
}
.pop-goods-spec-title {
  color: #333;
  padding: 10rpx 0 16rpx;
  font-size: 26rpx;
}
.pop-goods-spec-attrs {
  display: flex;
  flex-wrap: wrap;
}
.pop-goods-spec-attr {
  margin: 0 16rpx 16rpx 0;
  padding: 16rpx 24rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 8rpx;
  background-color: #f7f7f7;
  color: #333;
  font-size: 24rpx;
  line-height: 1;
}
.pop-goods-spec-attr.checked {
  border-color: #EB405D;
  background-color: #fff4f0;
  color: #EB405D;
}
.pop-goods-spec-attr.unable {
  border-color: #f7f7f7;
  background-color: #fafafa;
  color: #d0d0d0;
}
.popup-confirm-wrap {
  padding: 12rpx 28rpx 8rpx;
}
.confirm {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
  background-color: #EB405D;
}
.confirm.outof {
  background-color: #c8c8c8;
}

/* 优惠券 */
.coupons{
  margin-top: 20rpx;
  background-color: #ffffff;
}
.coupons .title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 20rpx 30rpx;
  border-bottom: 1px solid #f5f5f5;
}
.title .r {
  color: #999999;
  font-size: 24rpx;
}
.coupon-list {
  padding: 18rpx 0;
}
.empty{
  font-size: 24rpx;
  color: #666666;
  padding: 10rpx 30rpx;
}
.coupon {
  padding: 18rpx 30rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666666;
}
.coupon .desc {
  width: 300rpx;
  margin-left: 20rpx;
}
.coupon .period {
  flex-grow: 1;
  text-align: right;
}

/* 单选 */
.select-btn {
  box-sizing: border-box;
  border: 1px solid #666666;
  border-radius: 20rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.select-btn image {
  width: 28rpx;
  height: 28rpx;
}
.selected {
  border-color: #EB405D;
  background-color: #EB405D;
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 订单备注 */
.remark-input {
  width: 100%;
  box-sizing: border-box;
  height: 140rpx;
  padding: 20rpx 30rpx;
  font-size: 24rpx;
  color: #333333;
  line-height: 36rpx;
}

/* 价格明细 */
.price-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 30rpx;
  font-size: 26rpx;
  color: #666666;
}
.price-row .discount {
  color: #EB405D;
}
.price-row.total {
  border-top: 1px solid #f5f5f5;
  color: #333333;
  font-size: 28rpx;
}
.price-row.total .pay {
  color: #EB405D;
  font-size: 32rpx;
  font-weight: bold;
}

/* 支付方式 */
.pay-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1px solid #f5f5f5;
  font-size: 26rpx;
}
.pay-item:last-child {
  border-bottom: none;
}
.pay-name {
  color: #333333;
}
.pay-desc {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #EB405D;
}
.pay-item .select-btn {
  margin-left: auto;
}

/* 号码保护 */
.protect-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx 10rpx;
  font-size: 28rpx;
  color: #333333;
}
.protect-desc {
  padding: 0 30rpx 24rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #999999;
}

/* 底部结算栏 */
.bottom {
  height: 100rpx;
  width: 100%;
  position: fixed;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  border-top: 1px solid #f5f5f5;
}
.bottom .amount {
  margin-left: 30rpx;
}
.bottom .btn {
  background-color: #EB405D;
  color: #ffffff;
  width: 200rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 24rpx;
}
