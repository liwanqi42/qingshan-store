page {
  background-color: #f5f5f5;
}

.profile-page {
  padding: 24rpx 20rpx 60rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 0 40rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.avatar-btn {
  width: 150rpx;
  height: 150rpx;
  padding: 0;
  margin: 0;
  background-color: transparent;
  border-radius: 75rpx;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 75rpx;
  background-color: #f0f0f0;
}

.avatar-tip {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #999999;
}

.form-card {
  margin-top: 20rpx;
  padding: 0 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1px solid #f2f2f2;
  font-size: 28rpx;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 130rpx;
  color: #333333;
}

.input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #333333;
}

.picker {
  font-size: 28rpx;
  color: #333333;
}

.save-btn {
  margin-top: 50rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #ffffff;
  background-color: #EB4D50;
  border-radius: 44rpx;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  color: #ffffff;
  background-color: #f0a5a7;
}
