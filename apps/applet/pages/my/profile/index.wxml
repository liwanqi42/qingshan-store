<view class="profile-page">
  <view class="avatar-section">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatar || '/images/icon/avatar.svg'}}" mode="aspectFill" />
    </button>
    <view class="avatar-tip">{{uploading ? '上传中...' : '点击更换头像'}}</view>
  </view>

  <view class="form-card">
    <view class="form-item">
      <view class="label">昵称</view>
      <input
        class="input"
        type="nickname"
        value="{{name}}"
        maxlength="32"
        placeholder="请输入昵称"
        bindinput="onNameInput"
        bindblur="onNameBlur"
      />
    </view>
    <view class="form-item">
      <view class="label">性别</view>
      <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
        <view class="picker">{{genderOptions[genderIndex]}} ›</view>
      </picker>
    </view>
  </view>

  <button class="save-btn" loading="{{saving}}" disabled="{{uploading}}" bindtap="saveProfile">保存</button>
</view>
<login-auth id="loginAuth" />
