page {
  background-color: #f5f5f5;
}
.order-detail {
  padding: 16rpx 20rpx 140rpx;
}

/* 自动取消倒计时 */
.countdown-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background-color: #fff3f3;
  border-radius: 12rpx;
  text-align: center;
}
.countdown-text {
  font-size: 26rpx;
  color: #EB405D;
}

/* 收货地址 */
.address-card {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 28rpx 24rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
}
.address-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.address-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.address-info .status-line {
  display: flex;
  align-items: flex-start;
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
}
.status-line .ship-status {
  flex-shrink: 0;
  margin-right: 16rpx;
  color: #EB405D;
}
.status-line .ship-status.signed {
  color: #07C160;
}
.status-line .address-text {
  flex: 1;
  min-width: 0;
  line-height: 42rpx;
}
.contact-line {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666666;
}
.contact-line .phone {
  margin-left: 16rpx;
}

/* 商品信息 */
.goods-card {
  margin-bottom: 20rpx;
  padding: 0 24rpx 20rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
}
.goods-list .goods {
  display: flex;
  padding: 24rpx 0;
}
.goods image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background-color: #f5f5f5;
}
.goods .info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.info .name {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.info .specs {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #999999;
}
.goods .amount {
  width: 130rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 26rpx;
}
.amount .price {
  color: #333333;
}
.amount .num {
  margin-top: 6rpx;
  color: #999999;
}
.goods-actions {
  display: flex;
  justify-content: flex-end;
}
.action-btn {
  padding: 8rpx 28rpx;
  border: 1rpx solid #dddddd;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #333333;
}


/* 实付款（点击展开明细） */
.pay-card {
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
}
.pay-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 100rpx;
}
.pay-header .label {
  font-size: 28rpx;
  color: #333333;
}
.pay-right {
  display: flex;
  align-items: baseline;
}
.pay-right .amount {
  font-size: 36rpx;
  font-weight: 600;
  color: #222222;
}
.pay-right .arrow {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #999999;
  transition: transform 0.2s;
}
.pay-right .arrow.up {
  transform: rotate(180deg);
}
.pay-detail {
  padding: 8rpx 0 20rpx;
  border-top: 1rpx solid #f5f5f5;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #666666;
}
.detail-row .minus {
  color: #EB405D;
}

/* 订单信息 */
.info-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
}
.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 72rpx;
}
.info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
}
.info-header .arrow {
  font-size: 24rpx;
  color: #999999;
  transition: transform 0.2s;
}
.info-header .arrow.up {
  transform: rotate(180deg);
}
.info-detail {
  padding-top: 8rpx;
  border-top: 1rpx solid #f5f5f5;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #666666;
}
.info-row .label {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.label .eye {
  width: 30rpx;
  height: 30rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}
.info-row .value {
  display: flex;
  align-items: center;
  color: #333333;
}
.info-row .copy {
  margin-left: 16rpx;
  flex-shrink: 0;
  color: #EB405D;
}
.info-row .value.receiver {
  flex: 1;
  min-width: 0;
  justify-content: flex-end;
  text-align: right;
}
.receiver .receiver-text {
  flex: 1;
  min-width: 0;
  line-height: 36rpx;
  word-break: break-all;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  bottom: 0;
  box-sizing: border-box;
  width: 100%;
  height: 100rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  background-color: #ffffff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.bar-link {
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #666666;
}
.spacer {
  flex: 1;
}
.bar-btn {
  margin-left: 16rpx;
  padding: 10rpx 28rpx;
  border: 1rpx solid #dddddd;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #333333;
}
/* 与「确认收货」按钮等宽（4 个字 + 左右内边距 + 边框） */
.bar-btn-wide {
  min-width: 162rpx;
  box-sizing: border-box;
  text-align: center;
}
.bar-btn.active {
  border-color: #EB405D;
  color: #EB405D;
}
/* 倒计时归零后禁用付款 */
.bar-btn.disabled {
  border-color: #dddddd;
  background-color: #ffffff;
  color: #bbbbbb;
}
.bar-btn.primary {
  border-color: #EB405D;
  background-color: #EB405D;
  color: #ffffff;
}
.navigator-hover {
  background-color: #ffffff;
  opacity: 1
}

/* 售后弹窗 */
.shade {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 10;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.5);
}
.refound-reason {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  background-color: #ffffff;
  font-size: 24rpx;
}
.refound-reason .title {
  padding: 20rpx;
  font-size: 28rpx;
  text-align: center;
}
.refound-reason .type-section {
  padding: 0 20rpx;
}
.refound-reason .section-label {
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666666;
}
.type-list {
  display: flex;
  padding-bottom: 10rpx;
}
.type-item {
  flex: 1;
  margin-right: 20rpx;
  padding: 16rpx 0;
  border: 1rpx solid #D8D8D8;
  border-radius: 8rpx;
  text-align: center;
  color: #333333;
}
.type-item:last-child {
  margin-right: 0;
}
.type-item.checked {
  border-color: #EB405D;
  color: #EB405D;
  background-color: #FFF5F7;
}
.refound-reason .reason {
  padding: 0 20rpx 20rpx;
}
.reason .item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  line-height: 80rpx;
  border-bottom: 1px solid #F5F5F5;
}
.item .radio {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  border: 1px solid #D8D8D8;
  border-radius: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.item .checked {
  border-color: #EB405D;
}
.radio image {
  width: 24rpx;
  height: 24rpx;
}
.popup-btns {
  display: flex;
}
.closeBtn,.confirmBtn {
  width: 50%;
  height: 80rpx;
  color: #ffffff;
  background-color: #EB4D50;
  text-align: center;
  line-height: 80rpx;
}
.closeBtn {
  background-color: black;
  color: #ffffff;
}
