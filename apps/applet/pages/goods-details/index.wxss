.not-found {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding-top: 200rpx;
  font-size: 24rpx;
}
.not-found-icon {
  width: 140rpx;
  height: 140rpx;
}
.not-found .hint {
  margin-top: 20rpx;
  color: #979797;
}

/* 页面容器：不要使用全局 .container，避免被 app.wxss 的 flex 布局影响 */
.page {
  display: block;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 商品轮播 */
.gallery {
  position: relative;
  width: 100%;
  background-color: #fff;
}
.gallery-swiper {
  width: 100%;
  height: 750rpx;
}
.gallery-image {
  width: 100%;
  height: 750rpx;
  display: block;
}
.gallery-count {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  background-color: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 22rpx;
  line-height: 32rpx;
}

/* 通用卡片 */
.card {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-sizing: border-box;
}

/* 第一个 box：价格 + 名称 */
.price-card {
  padding: 26rpx 24rpx 24rpx;
}
.price-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.price {
  display: flex;
  align-items: baseline;
  color: #ff4400;
  font-weight: bold;
}
.price-unit {
  font-size: 30rpx;
}
.price-num {
  font-size: 56rpx;
  line-height: 1;
  margin-left: 2rpx;
  letter-spacing: -1rpx;
}
.share-btn {
  display: flex;
  align-items: center;
  height: 48rpx;
  padding: 0 18rpx;
  margin: 0;
  border-radius: 24rpx;
  background-color: #f7f7f7;
  line-height: 1;
  border: none;
}
.share-btn::after {
  border: none;
}
.share-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
}
.share-label {
  font-size: 22rpx;
  color: #666;
}
.goods-name {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
  line-height: 1.45;
  word-break: break-all;
}
.goods-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}
.goods-meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.meta-item {
  margin-right: 28rpx;
  font-size: 22rpx;
  color: #999;
}

/* 第二个 box：收货地址 + 样式规格 */
.info-card {
  padding: 0 24rpx;
}
.info-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
}
.row-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.row-main {
  flex: 1;
  min-width: 0;
}
.row-arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.row-divider {
  height: 1rpx;
  background-color: #f2f2f2;
}
.address-text {
  font-size: 28rpx;
  color: #222;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.address-user {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #666;
}
.address-mobile {
  margin-left: 16rpx;
}
.address-placeholder {
  font-size: 28rpx;
  color: #222;
}
.address-hint {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #bbb;
}
.spec-row {
  min-height: 92rpx;
}
.row-label {
  width: 78rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #999;
}
.spec-selected {
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.spec-panel {
  padding: 8rpx 0 24rpx;
}
.spec-group {
  margin-top: 20rpx;
}
.spec-title {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}
.spec-options {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}
.spec-option {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 26rpx;
  margin: 0 16rpx 14rpx 0;
  border-radius: 8rpx;
  border: 1rpx solid #f0f0f0;
  background-color: #f7f7f7;
  color: #333;
  font-size: 24rpx;
}
.spec-option.is-active {
  border-color: #ff4400;
  background-color: #fff4f0;
  color: #ff4400;
  font-weight: 500;
}
.spec-option.is-disabled {
  border-color: #f7f7f7;
  background-color: #fafafa;
  color: #d0d0d0;
}

/* 第三个 box：商品详情长图 */
.detail-card {
  padding-bottom: 12rpx;
}
.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0 24rpx;
}
.section-title-text {
  margin: 0 20rpx;
  font-size: 28rpx;
  color: #333;
}
.section-line {
  width: 60rpx;
  height: 1rpx;
  background-color: #e5e5e5;
}
.detail-images {
  width: 100%;
}
.detail-image {
  width: 100%;
  display: block;
}
.detail-empty {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  padding: 70rpx 0;
}

/* 底部操作栏 */
.footer-placeholder {
  height: 20rpx;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}
.footer-icon {
  width: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
}
.footer-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.footer-label {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #666;
}
.cart-badge {
  position: absolute;
  top: -4rpx;
  right: 10rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 14rpx;
  background-color: #ff4400;
  color: #fff;
  font-size: 18rpx;
  box-sizing: border-box;
}
.footer-actions {
  flex: 1;
  display: flex;
  margin-left: 12rpx;
}
.footer-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}
.btn-cart {
  margin-right: 16rpx;
  background: linear-gradient(90deg, #ff9500, #ff7a00);
}
.btn-buy {
  background: linear-gradient(90deg, #ff5000, #ff2d00);
}

/* 规格选择弹窗 */
.show-popup {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
}
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}
.popup-contents {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.popup-head {
  position: relative;
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx 20rpx;
}
.pop-img-box {
  width: 150rpx;
  height: 150rpx;
  margin-right: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background-color: #f7f7f7;
}
.pop-img-box .goods-thumbnail {
  width: 150rpx;
  height: 150rpx;
}
.pop-goods-des {
  flex: 1;
  min-width: 0;
}
.pop-goods-price {
  color: #ff4400;
  font-size: 38rpx;
  font-weight: bold;
  line-height: 1.1;
}
.pop-price-unit {
  font-size: 24rpx;
  margin-right: 2rpx;
}
.pop-goods-stock {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}
.pop-goods-stockName {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.popup-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 40rpx;
  color: #999;
}
.pop-goods-specs {
  margin: 0 28rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f2f2f2;
}
.pop-goods-spec-title {
  color: #333;
  padding: 10rpx 0 16rpx;
  font-size: 26rpx;
}
.pop-goods-spec-attrs {
  display: flex;
  flex-wrap: wrap;
}
.pop-goods-spec-attr {
  margin: 0 16rpx 16rpx 0;
  padding: 16rpx 24rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 8rpx;
  background-color: #f7f7f7;
  color: #333;
  font-size: 24rpx;
  line-height: 1;
}
.pop-goods-spec-attr.checked {
  border-color: #ff4400;
  background-color: #fff4f0;
  color: #ff4400;
}
.pop-goods-spec-attr.unable {
  border-color: #f7f7f7;
  background-color: #fafafa;
  color: #d0d0d0;
}
.buy-num-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 10rpx 28rpx 0;
  padding: 24rpx 0;
  border-top: 1rpx solid #f2f2f2;
}
.num-label {
  font-size: 26rpx;
  color: #333;
}
.operation-btn-group {
  display: flex;
  align-items: center;
}
.popup-confirm-wrap {
  padding: 12rpx 28rpx 8rpx;
}
.confirm {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
  background: linear-gradient(90deg, #ff5000, #ff2d00);
}
.confirm.outof {
  background: #c8c8c8;
}
